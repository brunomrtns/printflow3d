# PrintFlow3D — environment configuration
#
# Local development (docker-compose.yml / manual run):
APP_URL=http://localhost:5173
API_URL=http://localhost:8080
APP_PORT=5173
API_PORT=8080
UPLOAD_PATH=./data/uploads
DATA_PATH=./data/db

# Backend (also set inside the images):
# FILE_STORAGE   — directory for uploaded model files (container: /app/uploads)
# DB_PATH        — SQLite database file (container: /app/data/data.db)
# WEBUI_URL      — public URL of the web UI (used as default CORS origin)
# ALLOWED_ORIGINS — comma-separated extra CORS origins (optional)
# ROOT_PATH      — public path prefix behind a reverse proxy (prod: /3dpanel)
# STATIC_DIR     — compiled frontend dir; set to enable all-in-one SPA serving
# MAKERWORLD_BAMBU_TOKEN — optional MakerWorld token seeded into settings

# Frontend build (Vite, baked at build time):
# VITE_BASE_PATH — public base path of the app (prod: /3dpanel/, dev: /)
# VITE_API_URL   — public API base without /api suffix (prod: /3dpanel)
# VITE_API_PROXY_TARGET — dev-server proxy target for /api (default http://localhost:8080)
